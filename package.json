{
  "name": "@nbtca/nbtcal",
  "version": "0.4.0",
  "description": "Data-only calendar library for public feeds and authenticated personal timetables.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./timetable": {
      "types": "./dist/timetable/index.d.ts",
      "import": "./dist/timetable/index.js"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "precheck:package": "npm run build",
    "check:package": "node scripts/check-package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=moderate",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run check:package && npm run audit",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "ics",
    "ical",
    "calendar",
    "nbtca",
    "timetable"
  ],
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nbtca/nbtcal.git"
  },
  "bugs": {
    "url": "https://github.com/nbtca/nbtcal/issues"
  },
  "homepage": "https://github.com/nbtca/nbtcal#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "dependencies": {
    "ical.js": "^2.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "20.12.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
